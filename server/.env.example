# Server-side only. Never commit .env and never expose these in client code or VITE_* variables.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
PORT=8787

# Comma-separated list of allowed site origins (CORS). Dev default is the Vite origin.
ALLOWED_ORIGINS=http://localhost:3000
# Set to 1 when running behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=0

# Handoff email (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ESCALATION_TO=info@eyecojic.com
